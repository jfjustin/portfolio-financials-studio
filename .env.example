# Portfolio Financials Studio — configuration.
# Copy to `.env` and edit. Everything is optional: with no .env the app runs in
# deterministic-only mode (no model, no credentials, nothing leaves the machine).

# ---------------------------------------------------------------------------
# LLM fallback provider — used ONLY for non-standard layouts, always human-reviewed.
#   none    deterministic only (default; ideal for demos)
#   azure   customer's Microsoft model (Azure OpenAI, inside their Azure tenant)
#   openai  public OpenAI cloud
#   ollama  local, on-machine model
# ---------------------------------------------------------------------------
LLM_PROVIDER=none

# --- Customer Microsoft model: Azure OpenAI (LLM_PROVIDER=azure) ---
# Data stays inside the customer's Azure subscription; not shared with OpenAI.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_API_VERSION=2024-10-21
# Auth option A — API key:
AZURE_OPENAI_API_KEY=
# Auth option B — Microsoft Entra ID (keyless). Set true and authenticate via
# azure-identity (managed identity / az login / env). Leave API key blank.
AZURE_USE_ENTRA_ID=false

# --- Public OpenAI cloud (LLM_PROVIDER=openai) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=            # optional: OpenAI-compatible gateway

# --- Local Ollama (LLM_PROVIDER=ollama) ---
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# ---------------------------------------------------------------------------
# Database — blank uses the local SQLite file; set for Azure SQL / PostgreSQL
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname
# DATABASE_URL=mssql+pyodbc://user:pass@server.database.windows.net/db?driver=ODBC+Driver+18+for+SQL+Server

# ---------------------------------------------------------------------------
# Source-document storage — local folder, or Azure Blob in the tenant
# ---------------------------------------------------------------------------
STORAGE_BACKEND=local                 # local | azure
# AZURE_STORAGE_ACCOUNT_URL=https://youracct.blob.core.windows.net
# AZURE_STORAGE_CONTAINER=fund-documents
# AZURE_STORAGE_CONNECTION_STRING=    # optional; else uses Entra ID / managed identity

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
AUTH_MODE=none                        # none | password | entra
SESSION_SECRET=change-me-in-production
# password mode:
# APP_PASSWORD=choose-a-shared-password
# entra mode:
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_REDIRECT_PATH=/auth/callback

# ---------------------------------------------------------------------------
# Extraction behavior
# ---------------------------------------------------------------------------
AUTO_ACCEPT_CONFIDENCE=0.95
RECONCILE_TOLERANCE=1.0

# ---------------------------------------------------------------------------
# Server (localhost only by default)
# ---------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8713
